---
import Button from '@/components/Button.astro';

interface LinkItem {
  title: string;
  description: string;
  href: string;
  cta?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  items: LinkItem[];
}

const { title, subtitle, items } = Astro.props as Props;
---

<section class="mx-auto max-w-6xl px-6 py-8 md:py-16">
  <div class="mb-10 max-w-3xl">
    <h2 class="text-primary mb-4 text-3xl font-bold md:text-4xl">{title}</h2>
    {subtitle && <p class="text-muted-foreground text-lg leading-relaxed">{subtitle}</p>}
  </div>

  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    {
      items.map((item) => (
        <article class="bg-card flex h-full flex-col rounded-2xl border border-slate-200 p-6 shadow-sm transition-shadow hover:shadow-md">
          <h3 class="text-foreground mb-3 text-xl font-bold">{item.title}</h3>
          <p class="text-muted-foreground mb-6 flex-1 leading-relaxed">{item.description}</p>
          <Button href={item.href} variant="secondary" size="sm">
            {item.cta ?? 'Ver página'}
          </Button>
        </article>
      ))
    }
  </div>
</section>
