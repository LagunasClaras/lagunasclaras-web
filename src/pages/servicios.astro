---
import Breadcrumb from '@/components/Breadcrumb.astro';
import PageHeader from '@/components/PageHeader.astro';
import SeoHead from '@/components/SeoHead.astro';
import Layout from '@/layouts/Layout.astro';
import ServiceBlock from '@/sections/services/ServiceBlock.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';

const allServices = await getCollection('services');

// Prioritize sorting by the order property
const services = allServices.sort((a, b) => a.data.order - b.data.order);

const SeoContent = {
  title: 'Servicios de mantenimiento y limpieza de lagunas | Lagunas Claras',
  description:
    'Servicios profesionales de mantenimiento, limpieza y recuperación de lagunas y espejos de agua sin productos químicos.',
};

const content = {
  title: 'Servicios de mantenimiento y limpieza de lagunas',
  subtitle:
    'Ofrecemos soluciones integrales para la limpieza, el mantenimiento y la recuperación de lagunas y espejos de agua.',
};
---

<Layout>
  <SeoHead title={SeoContent.title} description={SeoContent.description} />
  <Fragment slot="main">
    <main class="bg-background mx-auto mt-24 min-h-screen w-[80%] pb-20">
      <Breadcrumb items={[{ label: 'Servicios', href: '/servicios' }]} />
      <PageHeader title={content.title} subtitle={content.subtitle} />

      <!-- Services List -->
      <div class="mx-auto flex max-w-6xl flex-col gap-20 px-6">
        {
          services.map((service, index) => {
            const isEven = index % 2 === 0;
            return (
              <ServiceBlock
                title={service.data.title}
                description={marked.parseInline(service.data.shortDescription) as string}
                image={service.data.thumbnail || service.data.hero.image}
                reverse={isEven}
                buttonRoute={`/servicios/${service.data.slug || service.id.replace(/\.mdx?$/, '')}`}
              />
            );
          })
        }
      </div>

    </main>
  </Fragment>
</Layout>
