---
import SeoHead from '@/components/SeoHead.astro';
import Layout from '@/layouts/Layout.astro';
import HomePage from '@sections/home/HomePage.astro';

const SeoContent = {
  title: 'Limpieza de lagunas y mantenimiento profesional | Lagunas Claras',
  description:
    'Limpieza de lagunas con maquinaria especializada, sin químicos y con cobertura en Buenos Aires y todo el país. Mantenimiento y recuperación profesional de lagunas, lagos y espejos de agua.',
};
---

<Layout>
  <SeoHead title={SeoContent.title} description={SeoContent.description} />
  <Fragment slot="main">
    <HomePage />
  </Fragment>
</Layout>
