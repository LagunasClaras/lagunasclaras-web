---
import Footer from '@/components/Footer.astro';
import { LAGUNAS_INFO } from '@/config/lagunasInfo';
import JsonLd from '@/components/JsonLd.astro';
import Navbar from '@/components/navbar/Navbar.astro';
import Toast from '@/components/Toast.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import '@/styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const {
  title = 'Lagunas Claras',
  description = 'Mantenimiento, limpieza y recuperación de lagunas y espejos de agua',
  robots = 'index, follow',
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? 'https://www.lagunasclaras.com';
const ogImageUrl = new URL('/og/lagunas-claras-og.webp', siteUrl).toString();
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: LAGUNAS_INFO.companyName,
  url: siteUrl,
  image: ogImageUrl,
  telephone: LAGUNAS_INFO.contacts.gustavo.phoneE164,
  email: LAGUNAS_INFO.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: LAGUNAS_INFO.location.address,
    addressLocality: 'Benavídez',
    addressRegion: 'Buenos Aires',
    addressCountry: 'AR',
  },
  areaServed: 'Argentina',
  description:
    'Empresa especializada en mantenimiento, limpieza y recuperación de lagunas y espejos de agua sin productos químicos.',
  sameAs: Object.values(LAGUNAS_INFO.social),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      !Astro.slots.has('default') && (
        <>
          <title>{title}</title>
          <meta name="description" content={description} />
        </>
      )
    }
    <ClientRouter />
    <meta
      name="keywords"
      content="lagunas claras, mantenimiento de lagunas, limpieza de lagunas, recuperación de lagunas, mantenimiento de espejos de agua"
    />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="bingbot" content={robots} />
    <meta name="yandex" content={robots} />

    <link rel="icon" type="image/svg+xml" href="/logo.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <JsonLd data={localBusinessSchema} />
    <slot />
  </head>

  <body class="bg-background text-foreground flex min-h-screen flex-col antialiased">
    <header>
      <Navbar />
    </header>

    <main id="main-content" class="flex-1">
      <slot name="main" />
    </main>

    <Footer />
    <WhatsAppButton />
    <Toast />
    <Analytics />
  </body>
</html>
<style is:global>
  @import '@/styles/global.css';
</style>
